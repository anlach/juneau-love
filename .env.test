# Committed test env for Playwright: playwright.config.ts builds the site
# with --mode test so these values are baked into the e2e build (the anon key
# is public by design — RLS is the boundary). Targets the local Supabase
# stack (`supabase start`); requires the stack's default JWT secret so the
# demo keys match. Local-only, never valid against a hosted project.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
