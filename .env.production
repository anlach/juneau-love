# Hosted build (vite build — mode "production" is Vite's default build
# mode, so this file is what both local `npm run build` and CI read).
# Committed on purpose: both values are public by design — they are
# inlined into the JS bundle every visitor downloads and Postgres RLS is
# the security boundary (same trust decision as the committed .env.test).
# This is the only place the CI build gets its env; no GitHub Actions
# variables or secrets are needed for the site.
PUBLIC_SUPABASE_URL=https://asuupanisvfxvbmdpcxt.supabase.co
# Supabase dashboard → Project Settings → API → Project API keys → anon (public)
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4p7h7I2Ig6RjdaEdSS00sg_wDi5tkKa
