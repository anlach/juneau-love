# Template for a gitignored local `.env` override only — normal dev / test /
# build need no local env (the committed per-mode files
# .env.development, .env.test, .env.production cover them). Hosted values
# are in .env.production; get them from the Supabase dashboard → Project
# Settings → API.
#
# SvelteKit only exposes PUBLIC_* vars to the browser, and this is a static
# site, so both values are baked in at build time. The anon key is public by
# design (RLS is the security boundary) — never add the service role key,
# the DB password, or the Management API key here.
PUBLIC_SUPABASE_URL=https://asuupanisvfxvbmdpcxt.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
