# /etc/mail-relay/env — mode 0600, owned by mailrelay
#
# Generate the token once (the same value becomes the MAIL_RELAY_TOKEN
# edge function secret in Supabase):
#   openssl rand -hex 32

RELAY_LISTEN=127.0.0.1:8080
RELAY_SMTP=127.0.0.1:25
RELAY_HELO=mail.juneau.love
RELAY_FROM=juneau.love <notify@juneau.love>
RELAY_MESSAGE_ID_DOMAIN=juneau.love
MAIL_RELAY_TOKEN=<64-hex-chars>
