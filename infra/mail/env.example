# /etc/mail-relay/env — mode 0600, owned by mailrelay
#
# Generate the token once (the same value becomes the MAIL_RELAY_TOKEN
# edge function secret in Supabase):
#   openssl rand -hex 32

RELAY_LISTEN=127.0.0.1:8080
RELAY_SMTP=127.0.0.1:25
RELAY_HELO=mail.juneau.love
RELAY_FROM=juneau.love <notify@juneau.love>
RELAY_MESSAGE_ID_DOMAIN=juneau.love
MAIL_RELAY_TOKEN=<64-hex-chars>

# GoTrue submission shim (:465, see README 6a). The listener is disabled
# without SMTP_SUBMIT_PASSWORD. The cert/key default to the staging
# copies in /etc/mail-relay/tls/ (refreshed by the certbot deploy hook).
#SMTP_SUBMIT_LISTEN=0.0.0.0:465
#SMTP_SUBMIT_CERT=/etc/mail-relay/tls/fullchain.pem
#SMTP_SUBMIT_KEY=/etc/mail-relay/tls/privkey.pem
#SMTP_SUBMIT_USER=notify@juneau.love
#SMTP_SUBMIT_PASSWORD=<the notify@juneau.love password>
