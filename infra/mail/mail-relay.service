# /etc/systemd/system/mail-relay.service
#
# The HTTP->SMTP relay (infra/mail/relay.ts in the juneau-love repo), plus
# the :465 SMTP submission listener that front-ends Supabase GoTrue: GoTrue
# dials :465 with implicit TLS (gomail treats port 465 as SSL) and AUTH
# PLAIN as notify@juneau.love; the shim re-sends the mail through the same
# code path as everything else (see relay.ts comments and
# knowledge/platform/mail.md). The token and SMTP password live in
# /etc/mail-relay/env (mode 0600, owned by the mailrelay user) — never in
# the unit file.
#
# TLS: the listener uses staging copies of the Let's Encrypt cert in
# /etc/mail-relay/tls/ (the mailrelay user cannot read /etc/letsencrypt).
# The certbot deploy hook renewal-hooks/deploy/mail-relay.sh re-copies
# them and restarts this service on every renewal.

[Unit]
Description=juneau.love mail relay (HTTP -> SMTP)
After=network-online.target maddy.service
Wants=network-online.target

[Service]
User=mailrelay
WorkingDirectory=/opt/mail-relay
# The capture dir needs BOTH --allow-read (captureSubmission's prune step
# does Deno.readDir) and --allow-write (writing each capture) — without
# them captureSubmission throws NotCapable and the "[submit] captured …"
# log line never prints (2026-10-26). The TLS dir needs --allow-read for
# the :465 listener certs.
ExecStart=/usr/local/bin/deno run --allow-net --allow-env --allow-read=/etc/mail-relay/tls --allow-read=/var/lib/mail-relay/captures --allow-write=/var/lib/mail-relay/captures /opt/mail-relay/relay.ts
Restart=always
RestartSec=5
EnvironmentFile=/etc/mail-relay/env
NoNewPrivileges=true
# The GoTrue shim binds privileged port 465 as the unprivileged
# mailrelay user (gomail only speaks implicit TLS on exactly port 465,
# so the shim can't move to an unprivileged port). Ambient caps work
# with NoNewPrivileges and must also be in the bounding set.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
